# Bash Production Toolkit - Example Configuration
# Copy this file and set your values:
#   cp toolkit.env.example toolkit.env
#   chmod 600 toolkit.env
#   source toolkit.env

# ============================================
# Toolkit Location
# ============================================

# Path to toolkit source directory
TOOLKIT="/path/to/bash-production-toolkit/src"

# ============================================
# Logging Configuration
# ============================================

# Minimum log level: DEBUG, INFO, NOTICE, WARN, ERROR, CRITICAL
LOG_LEVEL=INFO

# Output format: standard, json, compact
LOG_FORMAT=standard

# Enable journald integration (systemd)
LOG_TO_JOURNAL=false

# Output to terminal
LOG_TO_STDOUT=true

# Custom log file (optional)
# LOG_FILE="/var/log/myapp.log"

# Log directory (default: /var/log)
LOG_DIR=/var/log

# Log rotation settings
LOG_ROTATE_SIZE=10M
LOG_ROTATE_COUNT=5

# ============================================
# Webhook Alerting (Mattermost/Slack/Discord)
# ============================================

# Required: Slack-compatible webhook endpoint URL
# Mattermost: https://your-mm.example.com/hooks/TOKEN
# Slack:      https://hooks.slack.com/services/T/B/TOKEN
# Discord:    https://discord.com/api/webhooks/ID/TOKEN
ALERT_WEBHOOK_URL="https://your-webhook-endpoint/TOKEN"

# Optional: CA cert for self-signed TLS endpoints
# ALERT_WEBHOOK_CACERT="/path/to/ca.crt"

# Optional: Message prefix (default: [System])
ALERTS_PREFIX="[MyServer]"

# Optional: Rate limit in seconds (default: 1800 = 30min)
RATE_LIMIT_SECONDS=1800

# Optional: Enable recovery notifications (default: true)
ENABLE_RECOVERY_ALERTS=true

# ============================================
# Smart Alerts Configuration
# ============================================

# Grace period before alerting (default: 180 = 3min)
# Prevents alerts for brief transient issues
SMART_ALERT_GRACE_PERIOD=180

# Minimum downtime for recovery alert (default: 300 = 5min)
# Only sends recovery if issue lasted longer
SMART_ALERT_RECOVERY_THRESHOLD=300

# Event aggregation window (default: 300 = 5min)
SMART_ALERT_AGGREGATION_WINDOW=300

# Enable smart alerts (default: true)
SMART_ALERT_ENABLED=true

# ============================================
# State Directories
# ============================================

# Directory for alert state files
STATE_DIR=/var/lib/alerts

# Directory for smart-alerts state files
SMART_ALERT_STATE_DIR=/var/lib/smart-alerts

# ============================================
# Device Detection
# ============================================

# Path to device configuration file, read with yq if present
# (default: devices.yml next to device-detection.sh)
# DEVICE_CONFIG_FILE="/etc/devices.yml"

# Force specific device (for testing)
# DEVICE_OVERRIDE="my-server"

# ============================================
# Retry & Backoff
# ============================================

# First delay in seconds, doubled per attempt (default: 1)
RETRY_BASE_DELAY=1

# Maximum delay cap in seconds (default: 60)
RETRY_MAX_DELAY=60

# Max random jitter added in seconds, 0 = off (default: 0)
RETRY_JITTER=0

# Set to any value to disable the logging.sh integration
# RETRY_DISABLE_LOGGING=1

# ============================================
# Backup Safety
# ============================================

# Base directory for get_backup_path (default: /opt/backups)
BACKUP_BASE_DIR=/opt/backups

# Minimum free space a backup target must have, in GB (default: 10)
BACKUP_MIN_FREE_GB=10

# ============================================
# Debug Mode
# ============================================

# Enable verbose debug output
DEBUG=false
